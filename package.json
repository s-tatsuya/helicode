    "configuration": {
      "title": "Helicode",
      "properties": {
        "helicode.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable Helix keybindings."
        },
        "helicode.search.smartCase": {
          "type": "boolean",
          "default": true,
          "description": "Case-insensitive search unless the pattern contains an uppercase letter (Helix search.smart-case)."
        },
        "helicode.search.wrapAround": {
          "type": "boolean",
          "default": true,
          "description": "Wrap around the document when searching (Helix search.wrap-around)."
        },
        "helicode.scrolloff": {
          "type": "number",
          "default": 5,
          "description": "Lines of context kept around the cursor when paging (Helix scrolloff)."
        },
        "helicode.jumpLabelAlphabet": {
          "type": "string",
          "default": "abcdefghijklmnopqrstuvwxyz",
          "description": "Characters used for `gw` jump labels (Helix jump-label-alphabet)."
        },
        "helicode.defaultYankRegister": {
          "type": "string",
          "default": "\"",
          "description": "Register used by yank/delete/paste when none is selected (Helix default-yank-register). Use \"+\" to yank to the system clipboard."
        },
        "helicode.textWidth": {
          "type": "number",
          "default": 80,
          "description": "Default width for :reflow (Helix text-width)."
        },
        "helicode.shell": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Shell command used for | ! $ and :sh, e.g. [\"zsh\", \"-c\"]. Defaults to $SHELL -c."
        },
        "helicode.openLineUsesEditorIndent": {
          "type": "boolean",
          "default": true,
          "description": "After `o`/`O`, ask VS Code to re-indent the new line using language indentation rules."
        },
        "helicode.notebook.escapeQuitsCellEdit": {
          "type": "boolean",
          "default": true,
          "description": "In notebook cells, Escape in normal mode (with nothing pending) leaves cell editing and focuses the cell list."
        },
        "helicode.treeSitter.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable tree-sitter (WASM) powered textobjects, bracket matching and syntax node selection."
        },
        "helicode.treeSitter.maxFileSizeKB": {
          "type": "number",
          "default": 2048,
          "description": "Documents larger than this are not parsed with tree-sitter."
        },
        "helicode.treeSitter.extraGrammars": {
          "type": "object",
          "default": {},
          "markdownDescription": "Additional grammars keyed by VS Code language id: `{ \"lua\": { \"wasm\": \"/path/tree-sitter-lua.wasm\", \"queries\": \"/path/queries\", \"language\": \"lua\" } }`. `queries` is a directory containing `<language>/textobjects.scm` (Helix layout).",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "wasm": {
                "type": "string"
              },
              "queries": {
                "type": "string"
              },
              "language": {
                "type": "string"
              }
            }
          }
        },
        "helicode.keys": {
          "type": "object",
          "default": {},
          "markdownDescription": "Keymap overrides in Helix `config.toml` style, keyed by mode: `{ \"normal\": { \"C-s\": \":w\", \"g\": { \"a\": \"code_action\" } }, \"insert\": { \"j\": { \"k\": \"normal_mode\" } } }`. Values are Helix command names, `:typed commands`, or arrays of commands.",
          "properties": {
            "normal": {
              "type": "object"
            },
            "select": {
              "type": "object"
            },
            "insert": {
              "type": "object"
            }
          }
        },
        "helicode.shell.output": {
          "type": "string",
          "enum": [
            "beside",
            "here",
            "below"
          ],
          "enumDescriptions": [
            "Open the output beside the current editor without taking focus.",
            "Open the output in the current editor group.",
            "Split the current group down and open the output there."
          ],
          "default": "beside",
          "description": "Where `:sh` / `:run-shell-command` shows its output."
        }
      }
    }
  },
  "scripts": {
    "build": "node scripts/gen-keybindings.mjs && node esbuild.mjs",
    "build:prod": "node scripts/gen-keybindings.mjs && node esbuild.mjs --production",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node scripts/build-tests.mjs && node --test \"out/test/**/*.cjs\"",
    "check-queries": "node scripts/check-queries.mjs",
    "test:integration": "npm run build && node scripts/run-integration.mjs",
    "package": "npm run typecheck && npm run test && npm run build:prod && vsce package --no-dependencies",
    "gen-keybindings": "node scripts/gen-keybindings.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.19.11",
    "@types/vscode": "^1.104.0",
