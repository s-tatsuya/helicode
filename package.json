{
  "name": "helicode",
  "displayName": "Helicode - Helix keybindings",
  "description": "Faithful Helix editor keybindings for VS Code: selection-first editing, multiple cursors, match mode (mi/ma/ms/mr/md), jump labels (gw), tree-sitter textobjects (WASM) and : commands.",
  "version": "0.1.0",
  "publisher": "s-tatsuya",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/s-tatsuya/helicode"
  },
  "engines": {
    "vscode": "^1.104.0"
  },
  "categories": [
    "Keymaps",
    "Other"
  ],
  "keywords": [
    "helix",
    "kakoune",
    "modal",
    "vim",
    "keybindings",
    "tree-sitter"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "contributes": {
    "commands": [
      {
        "command": "helicode.toggle",
        "title": "Helicode: Toggle Helix keybindings"
      },
      {
        "command": "helicode.normalMode",
        "title": "Helicode: Enter normal mode"
      },
      {
        "command": "helicode.typed",
        "title": "Helicode: Run : command"
      },
      {
        "command": "helicode.showKeymapHelp",
        "title": "Helicode: Show keymap reference"
      },
      {
        "command": "helicode.showLog",
        "title": "Helicode: Show log"
      }
    ],
    "keybindings": [
      {
        "key": "escape",
        "command": "helicode.key",
        "args": {
          "key": "esc"
        },
        "when": "editorTextFocus && helicode.active && helicode.mode != 'insert' && !suggestWidgetVisible && !findWidgetVisible && !renameInputVisible && !parameterHintsVisible"
      },
      {
        "key": "enter",
